# ─────────────────────────────────────────────────────
# Synthesis demo — env config. Copy to .env.local and fill in.
# DO NOT commit .env.local. (.gitignore covers it.)
# ─────────────────────────────────────────────────────

# Anthropic API key — used in Production mode AND by the GCS ingest endpoint.
ANTHROPIC_API_KEY=

# ── GCS ingest path ─────────────────────────────────
# Service account key JSON. Paste as a single-line JSON string.
# In Vercel: paste the entire contents of insight-ingest-key.json here.
# Locally: easiest is to set GOOGLE_APPLICATION_CREDENTIALS to a file path instead.
GCP_SERVICE_ACCOUNT_KEY=

# Project + bucket
GCP_PROJECT_ID=squareup-492617
GCS_TRANSCRIPTS_BUCKET=squareup-transcripts-dev

# Optional: bucket label shown in the UI (no auth implications)
NEXT_PUBLIC_BUCKET_LABEL=squareup-transcripts-dev

# ── Pub/Sub auth (push subscription verification) ───
# The service account email used by the push subscription. Pinning enforces
# that only Pub/Sub-from-this-account can hit /api/ingest/gcs-event.
PUBSUB_PUSHER_EMAIL=insight-ingest@squareup-492617.iam.gserviceaccount.com

# Optional: enforce a specific OIDC audience (defaults to your Vercel URL).
# Set to e.g. https://synthesis-demo.vercel.app/api/ingest/gcs-event when
# you create the push subscription with --push-auth-token-audience
PUBSUB_OIDC_AUDIENCE=

# Local dev only — bypass OIDC verification with a shared secret.
# DO NOT set this on Vercel. Used to test the ingest endpoint on localhost.
PUBSUB_DEV_SHARED_SECRET=

# ── Defaults applied to ingest runs ─────────────────
DEFAULT_BRAND_CONTEXT=
DEFAULT_ONBOARDING_PLAN=
