# ─────────────────────────────────────────────────────
# insight-service — env config. Copy to .env.local and fill in.
# DO NOT commit .env.local. (.gitignore covers it.)
# ─────────────────────────────────────────────────────

# Anthropic API key — used by:
#   - Live/Production mode on /              (in-browser synthesis)
#   - /api/transcripts/aggregate             (cross-run trigger from /transcripts)
ANTHROPIC_API_KEY=

# ── GCS ─────────────────────────────────────────────
# Service account key JSON. Paste as a single-line JSON string.
# Wrap in single quotes so the `\n` escapes in the private_key survive
# the dotenv → JSON.parse round-trip.
GCP_SERVICE_ACCOUNT_KEY=

# Project + bucket
GCP_PROJECT_ID=squareup-492617
GCS_TRANSCRIPTS_BUCKET=squareup-transcripts-dev

# Optional: bucket label shown in the UI (no auth implications)
NEXT_PUBLIC_BUCKET_LABEL=squareup-transcripts-dev

# ── Defaults applied to ingest / cross runs ─────────
DEFAULT_BRAND_CONTEXT=
DEFAULT_ONBOARDING_PLAN=

# Note: this service used to receive Pub/Sub push events at /api/ingest/gcs-event.
# That path was retired in favour of the headless insights-engine puller — the
# Pub/Sub-related env vars (PUBSUB_PUSHER_EMAIL, PUBSUB_OIDC_AUDIENCE,
# PUBSUB_DEV_SHARED_SECRET) and lib/pubsub-auth.ts have been removed.
